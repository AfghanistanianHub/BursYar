# Public Firebase web identifiers. Never put Meta/service credentials in VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# Server process environment (Vite does not load these into the engine).
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
META_API_KEY=
META_MODEL_ID=
# Optional server deadline, 1..120000 ms; default 60000. No automatic retry.
META_TIMEOUT_MS=60000
BURSYAR_ORIGIN=http://localhost:5173
# Existing absolute persistent disk path; never use ephemeral disk for real inference.
BURSYAR_QUOTA_DB=
BURSYAR_USER_MINUTE=2
BURSYAR_USER_DAY=5
BURSYAR_GLOBAL_DAY=20
# Conservative input-byte + completion-token reservation units, NOT dollar amount.
BURSYAR_LIFETIME_UNITS=200000
# Optional local UTF-8 document workflow; parent must exist, owned by you, mode 700.
# Use a NEW database, never BURSYAR_QUOTA_DB or the existing credential file.
# BURSYAR_DOCUMENT_DB=/absolute/private-directory/documents.sqlite

# Hosting only: explicitly set 0.0.0.0. Default remains loopback-only.
BURSYAR_HOST=127.0.0.1

# Optional PUBLIC Firebase web API key. Enables caller-account REST checks after
# SDK signature verification; disabled/revoked/missing account evidence is denied.
# Without it, existing Admin SDK credential + checkRevoked=true mode is retained.
FIREBASE_WEB_API_KEY=

# Alternative durable hosted documents. Server-only: never use VITE_* for this key.
# Use the existing BursYar project and database/durable-documents.sql.
# Mutually exclusive with BURSYAR_DOCUMENT_DB and BURSYAR_FAMILY_GRANTS.
BURSYAR_DOCUMENT_SUPABASE_URL=
BURSYAR_DOCUMENT_SUPABASE_KEY=

# Hosted durable quotas reuse the server-only document Supabase credentials.
# Explicit alternative to BURSYAR_QUOTA_DB; never configure both.
BURSYAR_QUOTA_STORAGE=sqlite
# Optional secret-environment JSON alternatives to owner-only config files.
# File and JSON settings are mutually exclusive. Never use VITE_* here.
BURSYAR_PROVIDER_JSON=
BURSYAR_POLICY_RECORDS_JSON=
