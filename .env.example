# Public Firebase web identifiers. Never put Meta/service credentials in VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# Server process environment (Vite does not load these into the engine).
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
META_API_KEY=
META_MODEL_ID=
# Optional server deadline, 1..60000 ms; default remains 20000. No automatic retry.
META_TIMEOUT_MS=20000
BURSYAR_ORIGIN=http://localhost:5173
# Existing absolute persistent disk path; never use ephemeral disk for real inference.
BURSYAR_QUOTA_DB=
BURSYAR_USER_MINUTE=2
BURSYAR_USER_DAY=5
BURSYAR_GLOBAL_DAY=20
# Conservative input-byte + completion-token reservation units, NOT dollar amount.
BURSYAR_LIFETIME_UNITS=200000
# Optional local UTF-8 document workflow; parent must exist, owned by you, mode 700.
# Use a NEW database, never BURSYAR_QUOTA_DB or the existing credential file.
# BURSYAR_DOCUMENT_DB=/absolute/private-directory/documents.sqlite
