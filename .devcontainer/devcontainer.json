{
  "name": "BursYar Cloud Workspace",
  "remoteUser": "vscode",
  "updateContentCommand": "npm ci --ignore-scripts --no-audit --no-fund && npm run prepare:ocr",
  "postAttachCommand": "printf '\\nBursYar cloud workspace ready. Check docs/CLOUD-WORKSPACE.md before starting an agent.\\n'",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  }
}
