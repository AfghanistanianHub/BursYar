rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog is read-only. Client queries must include status == 'published'.
    match /scholarships/{scholarshipId} {
      allow get, list: if resource.data.status == 'published';
      allow create, update, delete: if false;
    }

    // Draft translations and reviewer notes are not public.
    match /scholarship_drafts/{id} {
      allow read, write: if false;
    }
    match /review_logs/{id} {
      allow read, write: if false;
    }

    // Deny everything not explicitly handled above, including user profile data
    // until an authorization model is documented and tested.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
