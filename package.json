{
  "name": "bursyar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "start:engine": "node engine/server.js",
    "test:emulator": "firebase emulators:exec --config firebase.emulator.json --project demo-bursyar --only auth,firestore \"node verification/emulator.mjs\"",
    "test:browser": "node verification/browser.mjs",
    "test:live": "node verification/live-demo.mjs",
    "start:demo": "node verification/start-demo.mjs",
    "start:mac": "node verification/macos-start.mjs",
    "setup:mac": "node verification/macos-start.mjs setup",
    "check:mac": "node verification/macos-start.mjs check",
    "diagnose:mac": "node verification/macos-start.mjs diagnose",
    "test:evaluation": "node verification/evaluate.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=24.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "firebase-tools": {
      "@opentelemetry/core": "^2.8.0",
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.1",
    "firebase-tools": "^15.34.1"
  },
  "packageManager": "npm@11.9.0"
}
